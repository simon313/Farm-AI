# Bardo Farm AI System — Required Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Anthropic API key for Claude vision calls in Gates 3 and 4
ANTHROPIC_API_KEY=

# Reolink camera credentials (shared across all cameras)
# Camera-specific IPs and placement labels live in config/cameras.yaml
CAMERA_USERNAME=
CAMERA_PASSWORD=
